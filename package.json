{
    "name": "@formatic-labs/qbo-mcp",
    "version": "0.1.0",
    "description": "MCP server implementation for QuickBooks Online integration",
    "license": "MIT",
    "main": "dist/lib.js",
    "types": "dist/lib.d.ts",
    "exports": {
        ".": {
            "types": "./dist/lib.d.ts",
            "import": "./dist/lib.js"
        }
    },
    "type": "module",
    "bin": "./dist/index.js",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/formatic-labs/qbo-mcp.git"
    },
    "scripts": {
        "build": "tsc && shx chmod +x dist/*.js",
        "prepare": "npm run build",
        "watch": "tsc --watch",
        "lint:fix": "eslint --fix",
        "lint": "eslint .",
        "auth": "node dist/auth-server.js",
        "encrypt-env": "node dist/encrypt-env.js",
        "encrypt-env:prod": "node scripts/with-prod-store.mjs dist/encrypt-env.js",
        "auth:prod": "node scripts/with-prod-store.mjs dist/auth-server.js",
        "pretest": "npm run build",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "dotenv": "^16.4.7",
        "intuit-oauth": "^4.2.5",
        "node-quickbooks": "^2.0.43",
        "open": "^9.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@jest/globals": "^30.3.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.13.10",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.1",
        "globals": "^16.0.0",
        "jest": "^30.2.0",
        "prettier": "3.5.3",
        "shx": "^0.3.4",
        "ts-jest": "^29.4.6",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.1"
    },
    "overrides": {
        "node-quickbooks": {
            "fast-xml-parser": "^5.10.1",
            "underscore": "^1.13.8",
            "uuid": "11.1.1"
        }
    }
}
